# Copy to .env. Empty required values deliberately prevent accidental startup.
APP_ENV=development
APP_NAME=Relay
LOG_LEVEL=INFO

# Generate a random PostgreSQL password, then put the same password in DATABASE_URL.
# Compose uses hostname db; a host-run backend uses localhost instead.
POSTGRES_USER=relay
POSTGRES_DB=relay
POSTGRES_PASSWORD=
DATABASE_URL=
# Example shape only: postgresql+asyncpg://relay:<url-encoded-password>@db:5432/relay

# Generate independently: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Generate independently for the isolated worker; do not reuse JWT_SECRET.
WORKER_JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
DEVICE_ACCESS_EXPIRE_MINUTES=15
DEVICE_REFRESH_EXPIRE_DAYS=30
ENROLLMENT_EXPIRE_MINUTES=10
DEVICE_CONTACT_COALESCE_SECONDS=60
RAW_EVENT_RETENTION_DAYS=30
IMAGE_OBJECT_RETENTION_DAYS=14
IMAGE_UPLOAD_SESSION_HOURS=24
IMAGE_MAX_ACTIVE_UPLOADS=3
IMAGE_UPLOADS_PER_HOUR=30
IMAGE_STORED_BYTES_PER_DEVICE=67108864
OBJECT_STORAGE_ROOT=./relay-object-storage
# Consented, operator-reviewed training copies (kept until deleted; never purged by retention).
TRAINING_DATASET_ROOT=./relay-training-dataset
# SMS verification: receipt wall-clock timezone and the SMS time window around the receipt minute.
RECEIPT_TIMEZONE=Africa/Cairo
SMS_MATCH_BEFORE_MINUTES=2
SMS_MATCH_AFTER_MINUTES=10
# The worker requires absolute, operator-controlled paths. Container defaults are set in Dockerfile.
OCR_TESSERACT_EXECUTABLE=
OCR_TESSDATA_DIR=
OCR_LANGUAGES=["eng","ara"]
OCR_TIMEOUT_SECONDS=20
# Failed OCR/evidence experiments stay off. Automatic field trust is reserved
# for a separately approved rollout and is rejected if enabled in Sprint 8.
RECEIPT_EVIDENCE_ENABLED=false
EXTRACTION_AUTO_TRUST_ENABLED=false
EXCEPTION_REVIEW_ENABLED=true
PROCESSING_STALE_MINUTES=5
PROCESSING_BATCH_LIMIT=10
OPERATOR_AUDIT_RETENTION_DAYS=365
OPERATOR_FRONTEND_DIR=./frontend/dist
# Optional "Forgot password" email links. Leave SMTP_HOST empty to use only
# recovery codes and the reset-password command. Gmail: smtp.gmail.com, port 587,
# your address as SMTP_USERNAME and an App Password as SMTP_PASSWORD.
# The address people open the console at, including /operator (e.g. https://relay.example.com/operator).
OPERATOR_PUBLIC_URL=
PASSWORD_RESET_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
JWT_ISSUER=relay
JWT_AUDIENCE=relay-admin

# JSON arrays; no browser origins are authorized by default.
CORS_ORIGINS=[]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
READINESS_TIMEOUT_SECONDS=3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
