{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay-offline-ocr-spike-manifest-v1",
  "type": "object",
  "required": ["samples"],
  "properties": {
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["sample_id", "source_filename", "language", "expected_receipt", "expected", "targets"],
        "properties": {
          "sample_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "source_filename": {"type": "string", "minLength": 1},
          "language": {"enum": ["ar", "en", "mixed"]},
          "expected_receipt": {"type": "boolean"},
          "expected": {
            "type": "object",
            "properties": {
              "amount": {"type": ["string", "null"]},
              "currency": {"type": ["string", "null"]},
              "reference": {"type": ["string", "null"]},
              "date": {"type": ["string", "null"]},
              "time": {"type": ["string", "null"]},
              "sender_handle": {"type": ["string", "null"]},
              "recipient_identifier": {"type": ["string", "null"]},
              "duplicate_group": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "notes": {"type": "array", "items": {"type": "string"}},
          "masked_fields": {"type": "array", "items": {"type": "string"}},
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "box"],
              "properties": {
                "field": {"enum": ["amount", "currency", "reference", "date", "time"]},
                "box": {
                  "type": "array",
                  "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}, {"type": "integer"}],
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
